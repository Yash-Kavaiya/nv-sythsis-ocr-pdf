# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM-backed generation (NVIDIA NIM) ---
NVIDIA_API_KEY=nvapi-...
# Optional: override model/endpoint used by schema design, synthesis,
# LaTeX repair, and the real NeMo Data Designer provider.
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- QROTAID web retrieval (Curator) ---
# Optional: enables retrieval of real-world document examples that ground
# schema design. Perplexity (via OpenRouter) first, Google SERP fallback.
# OPENROUTER_API_KEY=sk-or-...
# SERP_API_KEY=...

# --- Real NeMo Curator (optional, Linux + GPU) ---
# Set to 1 AND `pip install nemo-curator` to route seed curation through the
# real NeMo Curator pipeline instead of the in-app QROTAID curator.
# NEMO_CURATOR=1

# --- Runtime ---
# DATA_DIR=./data
# PORT=8000
# DEV_FRONTEND=1
